<!DOCTYPE html>
<html>
<head>
  <title>JAY.B Runner - Animated Characters</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin:0; overflow:hidden; background:#000; font-family:Arial; }
    canvas { display:block; }

    #menu, #gameUI {
      position:fixed; width:100%; text-align:center; color:#fff;
    }

    #menu { top:30%; }

    button {
      padding:12px 20px;
      margin:10px;
      font-size:18px;
      border:none;
      border-radius:10px;
    }

    #gameUI { top:10px; display:none; }
  </style>
</head>
<body>

<div id="menu">
  <h1>JAY.B Runner</h1>
  <button onclick="startGame()">▶ Play</button>
  <button onclick="toggleSound()">🔊 Sound</button>
  <br>
  <button onclick="changeCharacter()">🎭 Change Character</button>
</div>

<div id="gameUI">
  Score: <span id="score">0</span> | Coins: <span id="coins">0</span>
</div>

<canvas id="game"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");
canvas.width = innerWidth;
canvas.height = innerHeight;

let gameStarted = false;
let soundOn = true;

let lanes = [canvas.height-120, canvas.height-200, canvas.height-280];
let laneIndex = 1;

// CHARACTER SPRITES (animated frames)
let characterSprites = {
  "JAY.B": [],
  "DC SLEAZY": [],
  "DC CASH MERRI": []
};
let spriteFrame = 0;
let frameCounter = 0;

// Placeholder images (replace with your frames URLs)
for(let i=1;i<=4;i++){
  let img = new Image(); img.src = `https://i.imgur.com/JAYB_frame${i}.png`; characterSprites["JAY.B"].push(img);
  img = new Image(); img.src = `https://i.imgur.com/SLEAZY_frame${i}.png`; characterSprites["DC SLEAZY"].push(img);
  img = new Image(); img.src = `https://i.imgur.com/CASH_frame${i}.png`; characterSprites["DC CASH MERRI"].push(img);
}

let currentCharacter = "JAY.B";

let player, police, obstacles, coins, powerups;
let score, coinCount, speed, magnetTimer;

let music = new Audio("https://actions.google.com/sounds/v1/ambiences/city_ambience.ogg");
music.loop = true;

function init(){
  player = { x:100, y:lanes[laneIndex], w:60, h:60, shield:false, magnet:false };
  police = { x:20, y:lanes[laneIndex], w:50, h:50 };
  obstacles = []; coins = []; powerups = [];
  score = 0; coinCount = 0; speed = 6; magnetTimer = 0;
  spriteFrame = 0; frameCounter = 0;
}

function startGame(){
  document.getElementById("menu").style.display = "none";
  document.getElementById("gameUI").style.display = "block";
  gameStarted = true;
  init();
  if(soundOn) music.play();
  update();
}

function toggleSound(){
  soundOn = !soundOn;
  if(!soundOn) music.pause();
  else if(gameStarted) music.play();
}

function changeCharacter(){
  let names = Object.keys(characterSprites);
  let index = names.indexOf(currentCharacter);
  index = (index + 1) % names.length;
  currentCharacter = names[index];
  alert("Character: " + currentCharacter);
}

function spawnObstacle(){ obstacles.push({ x:canvas.width, lane:Math.floor(Math.random()*3) }); }
function spawnCoin(){ coins.push({ x:canvas.width, lane:Math.floor(Math.random()*3) }); }
function spawnPower(){ let types=["shield","magnet"]; powerups.push({x:canvas.width,lane:Math.floor(Math.random()*3),type:types[Math.floor(Math.random()*2)]}); }

function drawBackground(){
  ctx.fillStyle = "#111";
  ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle = "#222";
  for(let i=0;i<5;i++) ctx.fillRect(i*200-(score%200), canvas.height-300,100,200);
  ctx.strokeStyle="#555"; lanes.forEach(y=>{ ctx.beginPath(); ctx.moveTo(0,y+50); ctx.lineTo(canvas.width,y+50); ctx.stroke(); });
}

function update(){
  if(!gameStarted) return;
  ctx.clearRect(0,0,canvas.width,canvas.height);
  drawBackground();
  player.y = lanes[laneIndex]; police.y = lanes[laneIndex];

  // Animate character
  frameCounter++;
  if(frameCounter % 10 === 0){ spriteFrame = (spriteFrame + 1) % characterSprites[currentCharacter].length; }
  ctx.drawImage(characterSprites[currentCharacter][spriteFrame], player.x, player.y, player.w, player.h);

  // Police
  police.x += (player.x - police.x - 50)*0.02; ctx.fillStyle="white"; ctx.fillRect(police.x, police.y, police.w, police.h);

  // Obstacles
  obstacles.forEach((o,i)=>{
    o.x-=speed; let y=lanes[o.lane]; ctx.fillStyle="red"; ctx.fillRect(o.x,y,50,50);
    if(player.x<o.x+50 && player.x+50>o.x && player.y===y){
      if(player.shield){ player.shield=false; obstacles.splice(i,1); } else gameOver();
    }
  });

  // Coins
  coins.forEach((c,i)=>{ c.x-=speed; let y=lanes[c.lane]; if(player.magnet)c.x-=5; ctx.fillStyle="yellow"; ctx.beginPath(); ctx.arc(c.x,y+20,10,0,Math.PI*2); ctx.fill(); if(player.x<c.x+20 && player.x+50>c.x && player.y===y){ coinCount++; coins.splice(i,1); }});

  // Powerups
  powerups.forEach((p,i)=>{ p.x-=speed; let y=lanes[p.lane]; ctx.fillStyle=p.type==="shield"?"blue":"purple"; ctx.fillRect(p.x,y,30,30); if(player.x<p.x+30 && player.x+50>p.x && player.y===y){ if(p.type==="shield") player.shield=true; if(p.type==="magnet"){ player.magnet=true; magnetTimer=300;} powerups.splice(i,1); }});

  if(player.magnet){ magnetTimer--; if(magnetTimer<=0) player.magnet=false; }
  obstacles=obstacles.filter(o=>o.x>0); coins=coins.filter(c=>c.x>0); powerups=powerups.filter(p=>p.x>0);
  score++; speed+=0.002;
  document.getElementById("score").innerText=score;
  document.getElementById("coins").innerText=coinCount;
  requestAnimationFrame(update);
}

function gameOver(){ gameStarted=false; music.pause(); alert("Game Over! Score:"+score); location.reload(); }
function moveUp(){ if(laneIndex>0) laneIndex--; } function moveDown(){ if(laneIndex<2) laneIndex++; }
addEventListener("keydown",e=>{ if(e.key==="ArrowUp") moveUp(); if(e.key==="ArrowDown") moveDown(); });
let startY=0; addEventListener("touchstart",e=>startY=e.touches[0].clientY);
addEventListener("touchend",e=>{ let endY=e.changedTouches[0].clientY; if(startY-endY>50) moveUp(); else if(endY-startY>50) moveDown();});
setInterval(spawnObstacle,1000); setInterval(spawnCoin,1200); setInterval(spawnPower,4000);
</script>
</body>
</html>
